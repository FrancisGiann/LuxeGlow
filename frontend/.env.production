# ── Production build (vite build reads this automatically) ────
# The app is served same-origin from the XAMPP sub-folder, so API calls
# AND built-asset URLs must carry the sub-path prefix.
VITE_API_BASE=/luxeglow
VITE_LEGACY_APP_URL=/luxeglow
VITE_ASSET_BASE=/luxeglow/

# Router basename so /dashboard etc. resolve under the sub-folder
VITE_ROUTER_BASE=/luxeglow
