# ── Dev server (vite dev) ─────────────────────────────────────
# Proxy target: XAMPP/Apache origin + htdocs sub-folder
VITE_PHP_ORIGIN=http://localhost
VITE_PHP_SUBDIR=luxeglow

# Dev calls are same-origin through the Vite proxy — no prefix needed
VITE_API_BASE=

# Legacy PHP app for staff-login redirect
VITE_LEGACY_APP_URL=http://localhost/luxeglow
