# Browser-safe Supabase project values. The anon key is protected by RLS,
# but it is still the only key allowed in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Hosting path. Leave empty when the SPA is served at the domain root.
VITE_ASSET_BASE=/
VITE_ROUTER_BASE=/

# Idle session timeout in minutes. Values are bounded to 5 minutes–4 hours.
VITE_SESSION_IDLE_TIMEOUT_MINUTES=30
