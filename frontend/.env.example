# ── Dev server (Vite) ─────────────────────────────────────────
# Where XAMPP/Apache is running
VITE_PHP_ORIGIN=http://localhost

# Sub-folder of htdocs the PHP project lives in (leave empty if it sits at web root)
VITE_PHP_SUBDIR=Luxeglow

# ── Production build ──────────────────────────────────────────
# Base URL prefix for API + asset calls when dist/ is served from a sub-folder.
# Leave empty if served from domain root.
VITE_API_BASE=

# Legacy PHP app URL for staff login redirect (use a relative path in prod, e.g. /luxeglow)
VITE_LEGACY_APP_URL=http://localhost/luxeglow
