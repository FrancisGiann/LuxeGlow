# Server/Edge Function configuration. Never expose the service key to Vite.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional, temporary PHP compatibility port only. The legacy PHP endpoints
# are disabled unless all three values are configured; do not use for the SPA.
SUPABASE_PDO_DSN=pgsql:host=db.YOUR_PROJECT_REF.supabase.co;port=5432;dbname=postgres;sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Staff password recovery email provider.
RESEND_API_KEY=YOUR_RESEND_API_KEY
# SMTP transport used by process-notifications (implicit TLS requires port 465).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM_ADDRESS=appointments@example.com
MAIL_FROM_NAME="Astrid Nails & Beauty Bar"

# Scheduler authentication for the notification Edge Function endpoint.
CRON_SECRET_TOKEN=GENERATE_A_LONG_RANDOM_VALUE

# Staged SMS signup Edge Functions. Keep every switch false until the database,
# Auth hook, OTP expiry, recovery flow, and direct-API gates pass staging review.
SMS_SIGNUP_ENABLED=false
SMS_ALIAS_LOGIN_ENABLED=false
SMS_SENDING_ENABLED=false
SMS_SEND_SCOPE=test
SMS_TEST_PHONE=SET_ONLY_IN_SERVER_SECRET_FIELD_FOR_CONTROLLED_TEST
SMS_HOOK_SECRET=YOUR_STANDARD_WEBHOOK_SIGNING_SECRET
SMS_RATE_SECRET=GENERATE_A_SEPARATE_32_PLUS_CHARACTER_SECRET
UNISMS_SECRET_KEY=PASTE_ONLY_IN_SUPABASE_EDGE_SECRETS
UNISMS_SENDER_ID=ACCOUNT_ASSIGNED_SENDER

# Cloudinary Upload API credentials. Server/Edge Function only; never use VITE_.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# One-time read-only MariaDB exporter inputs. Do not deploy these variables
# with the SPA or Edge Functions; remove them after the cutover export.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_NAME=astrid_nails
LEGACY_DB_USER=readonly_migration_user
LEGACY_DB_PASS=YOUR_LEGACY_DB_PASSWORD
